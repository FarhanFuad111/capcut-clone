:root {
  font-family: 'Inter', sans-serif;
  color: #e5e7eb;
  background: #0b1020;
  line-height: 1.4;
  font-weight: 500;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-width: 100%;
  min-height: 100%;
  background:
    radial-gradient(circle at top, rgba(93, 104, 255, 0.22), transparent 30%),
    #0b1020;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.editor-shell {
  width: min(1500px, 100%);
  min-height: 920px;
  background: rgba(12, 18, 32, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 35px 80px rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(18px);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 22px;
  background: rgba(15, 23, 42, 0.88);
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 200px;
}

.logo-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #8b5cf6, #f97316);
  font-weight: 800;
  color: white;
  box-shadow: 0 10px 24px rgba(139, 92, 246, 0.45);
}

.brand-name {
  font-weight: 800;
  font-size: 1.1rem;
}

.project-label {
  color: #a5b4fc;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.top-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex: 1;
}

.top-actions button,
.ghost-btn,
.primary-btn,
.timeline-actions button,
.panel-header button,
.mini-btn {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.7);
  color: #e2e8f0;
  border-radius: 12px;
  padding: 10px 14px;
  transition: 0.2s ease;
}

.top-actions button:hover,
.ghost-btn:hover,
.primary-btn:hover,
.timeline-actions button:hover,
.panel-header button:hover,
.mini-btn:hover {
  border-color: rgba(96, 165, 250, 0.7);
  transform: translateY(-1px);
}

.top-actions .active {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.32), rgba(59, 130, 246, 0.23));
  border-color: rgba(147, 197, 253, 0.6);
}

.top-utility {
  display: flex;
  align-items: center;
  gap: 12px;
}

.primary-btn {
  background: linear-gradient(135deg, #8b5cf6, #3b82f6);
  border: none;
  box-shadow: 0 14px 28px rgba(59, 130, 246, 0.35);
}

.primary-btn.small {
  padding: 8px 12px;
  font-size: 0.84rem;
}

.workspace {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr) 280px;
  min-height: 610px;
}

.sidebar {
  background: rgba(15, 23, 42, 0.5);
  border-right: 1px solid rgba(148, 163, 184, 0.14);
  padding: 18px 16px;
}

.right-panel {
  border-right: none;
  border-left: 1px solid rgba(148, 163, 184, 0.14);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  font-weight: 700;
}

.library-filters {
  display: flex;
  gap: 8px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.filter {
  font-size: 0.78rem;
  padding: 8px 10px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid transparent;
  color: #cbd5e1;
}

.filter.active {
  background: rgba(96, 165, 250, 0.12);
  border-color: rgba(96, 165, 250, 0.5);
  color: #dbeafe;
}

.media-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.media-card {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 10px;
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 16px;
}

.thumb {
  width: 92px;
  height: 70px;
  border-radius: 14px;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
}

.media-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 4px 7px;
  border-radius: 999px;
  font-size: 0.6rem;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.15);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.media-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.media-meta strong {
  font-size: 0.92rem;
}

.media-meta span {
  color: #94a3b8;
  font-size: 0.72rem;
}

.canvas-panel {
  padding: 18px 18px 0;
  background: linear-gradient(180deg, rgba(10, 15, 28, 0.65), rgba(10, 15, 28, 0.9));
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(15, 23, 42, 0.74);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.8rem;
}

.dot {
  width: 8px;
  height: 8px;
  background: #34d399;
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(52, 211, 153, 0.8);
}

.time-indicator {
  font-size: 0.8rem;
  color: #cbd5e1;
}

.preview-stage {
  position: relative;
  height: 430px;
  border-radius: 26px;
  background:
    linear-gradient(135deg, rgba(79, 70, 229, 0.3), rgba(59, 130, 246, 0.1)),
    linear-gradient(140deg, #111827 0%, #0f172a 30%, #020617 100%);
  overflow: hidden;
  display: grid;
  place-items: center;
  border: 1px solid rgba(148, 163, 184, 0.14);
  box-shadow: inset 0 0 50px rgba(96, 165, 250, 0.12);
}

.preview-stage::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(130deg, rgba(15, 23, 42, 0.1), rgba(79, 70, 229, 0.3)),
    radial-gradient(circle at 25% 20%, rgba(99, 102, 241, 0.35), transparent 39%),
    radial-gradient(circle at 75% 45%, rgba(249, 115, 22, 0.26), transparent 32%);
}

.stage-glow {
  position: absolute;
  width: 70%;
  height: 70%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.26), transparent 62%);
}

.video-overlay {
  position: absolute;
  left: 28px;
  bottom: 20px;
  z-index: 2;
}

.video-overlay span {
  display: block;
  font-size: clamp(1.8rem, 3vw, 3.2rem);
  font-weight: 800;
  letter-spacing: -0.06em;
}

.video-overlay small {
  color: #bfd8ff;
  font-size: 0.8rem;
}

.play-ring {
  z-index: 2;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: grid;
  place-items: center;
  box-shadow: 0 20px 32px rgba(0, 0, 0, 0.33);
}

.triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 14px 0 14px 22px;
  border-color: transparent transparent transparent #f8fafc;
  margin-left: 6px;
}

.transport-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px 18px;
}

.mini-btn {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  padding: 0;
}

.play-btn {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #8b5cf6, #3b82f6);
  color: white;
  box-shadow: 0 18px 30px rgba(59, 130, 246, 0.4);
}

.transport-slider {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  padding-left: 4px;
  color: #cbd5e1;
  font-size: 0.8rem;
}

.slider-track {
  width: 100%;
  position: relative;
  height: 8px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.18);
  overflow: hidden;
}

.slider-progress {
  position: absolute;
  inset: 0 auto 0 0;
  width: 55%;
  background: linear-gradient(90deg, #8b5cf6, #3b82f6);
  border-radius: inherit;
}

.inspector-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 16px;
  padding: 14px 12px 10px;
  margin-bottom: 14px;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  color: #cbd5e1;
  font-size: 0.82rem;
}

.inspector-card input[type='range'] {
  width: 100%;
  accent-color: #8b5cf6;
}

.quick-effects {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.chip {
  background: rgba(148, 163, 184, 0.08);
  padding: 8px 10px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  font-size: 0.74rem;
  color: #dfe7f5;
}

.chip.active {
  background: rgba(192, 132, 252, 0.12);
  border-color: rgba(192, 132, 252, 0.5);
  color: #f5d0fe;
}

.timeline-panel {
  border-top: 1px solid rgba(148, 163, 184, 0.14);
  background: rgba(15, 23, 42, 0.85);
  padding: 16px 18px 18px;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.timeline-header strong {
  display: block;
  font-size: 1.1rem;
}

.timeline-header small {
  color: #9aa8bd;
}

.timeline-actions {
  display: flex;
  gap: 10px;
}

.timeline-ruler {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 4px;
  padding: 0 10px 8px;
  color: #94a3b8;
  font-size: 0.72rem;
}

.timeline-track {
  position: relative;
  height: 86px;
  margin-bottom: 12px;
  border-radius: 16px;
  background:
    linear-gradient(to right, rgba(148, 163, 184, 0.08) 1px, transparent 1px),
    rgba(15, 23, 42, 0.7);
  background-size: calc(100% / 12) 100%, 100% 100%;
  border: 1px solid rgba(148, 163, 184, 0.08);
  overflow: hidden;
}

.timeline-clip {
  position: absolute;
  top: 14px;
  height: 58px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  color: white;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  overflow: hidden;
  white-space: nowrap;
}

.timeline-clip.audio {
  top: 18px;
  height: 46px;
}

@media (max-width: 1180px) {
  .workspace {
    grid-template-columns: 260px minmax(0, 1fr);
  }

  .right-panel {
    display: none;
  }
}

@media (max-width: 860px) {
  body {
    padding: 14px;
  }

  .topbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .workspace {
    grid-template-columns: 1fr;
  }

  .left-panel {
    border-right: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .preview-stage {
    height: 340px;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
